# Development (default pool ~7 connections)
DATABASE_URL="postgresql://wbc:wbc_dev_2026@localhost:5432/wbc?schema=public"
# Production: append &connection_limit=20&pool_timeout=10 to DATABASE_URL
REDIS_URL="redis://localhost:6379/0"
# AUTH_SECRET must be at least 32 characters and must NOT contain placeholder
# patterns (change/secret/wbc-dev/placeholder/generate). Generate one with:
#   openssl rand -base64 48
AUTH_SECRET="REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_48"
AUTH_URL="http://localhost:3000"
NODE_ENV="development"
DEEPSEEK_API_KEY="your-deepseek-key"
MERCADOPAGO_ACCESS_TOKEN="your-mercadopago-token"
# ACH-043: HMAC secret for MercadoPago webhook signature verification.
# Without this set the /api/webhooks/mercadopago route returns 500.
MERCADOPAGO_WEBHOOK_SECRET="your-mercadopago-webhook-secret"
WHATSAPP_API_TOKEN="your-whatsapp-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
# WhatsApp App Secret used to verify HMAC signatures of incoming webhook payloads.
# Required: webhook handler rejects requests when missing.
WHATSAPP_APP_SECRET="your-whatsapp-app-secret"
RESEND_API_KEY="your-resend-key"
# ACH-046: from-address used by ResendEmailSender (transactional emails).
EMAIL_FROM="WBC <noreply@weavecode.co.uk>"
# ACH-046: CDN base URL for static assets (avatars, product images). Used
# by the avatar URL allow-list and by frontend asset helpers.
CDN_URL="https://wbc.cdn.weavecode.co.uk"
# ACH-040: optional CSP violation collector. When set, every CSP violation
# is POSTed here as JSON; pair with CSP_REPORT_TO + CSP_REPORT_TO_ENDPOINT
# for the modern Reporting API path.
CSP_REPORT_URI=""
CSP_REPORT_TO=""
CSP_REPORT_TO_ENDPOINT=""
SENTRY_DSN=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
