# WBC Platform — Production Environment Variables
# Copy to .env.production and fill in real values

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=wbc
POSTGRES_PASSWORD=REPLACE_WITH_OPENSSL_RAND_BASE64_24
POSTGRES_DB=wbc

# ACH-013 performance-escalabilidade: pin the Prisma connection pool
# per service so N workers * pool_size fits under Postgres max_connections.
# Capacity sheet (defaults, update if container counts change):
#   1 web instance   = 20 conns (API)
#   1 worker instance = 3 conns (connection_limit=3 below)
#   max_connections  = 100 on stock Postgres → headroom for admin/migration
# Example for the worker:
#   DATABASE_URL="postgresql://wbc_app:$WBC_APP_DB_PASSWORD@postgres:5432/wbc?connection_limit=3&pool_timeout=10"
# API can omit `connection_limit` (Prisma's default ~2 * vCPU + 1 fits 20).
# Document any change here in docs/architecture/postgres-ha.md.

# ACH-025: per-role passwords. Run packages/db/prisma/scripts/setup-roles.sql
# once with the superuser to provision wbc_app / wbc_migrations / wbc_readonly,
# then point the application services at wbc_app and migration jobs at
# wbc_migrations. Keep readonly for analytics / dashboards / oncall.
WBC_APP_DB_PASSWORD=REPLACE_WITH_OPENSSL_RAND_BASE64_24
WBC_MIGRATIONS_DB_PASSWORD=REPLACE_WITH_OPENSSL_RAND_BASE64_24
WBC_READONLY_DB_PASSWORD=REPLACE_WITH_OPENSSL_RAND_BASE64_24

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Auth ──────────────────────────────────────────────────────
# AUTH_SECRET must be ≥32 chars and free of weak/placeholder patterns
# (change/secret/wbc-dev/placeholder/generate). Generate with:
#   openssl rand -base64 48
AUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_48
AUTH_URL=https://app.seudominio.com.br

# ── External APIs ────────────────────────────────────────────
DEEPSEEK_API_KEY=your-deepseek-key
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-token
# Required if Mercado Pago is enabled — HMAC secret from the MP
# notifications config. Without it /api/webhooks/mercadopago rejects
# every callback with 401.
MERCADOPAGO_WEBHOOK_SECRET=CHANGE_ME_FROM_MERCADOPAGO_WEBHOOK_DASHBOARD
# Surfaces the "PIX auto" button in /finance and /sales/[id]. Flip to
# "true" in production once the MP token + webhook secret are in
# place; defaults to disabled so the dynamic flow stays hidden until
# the operator opts in.
NEXT_PUBLIC_MERCADOPAGO_ENABLED=false
WHATSAPP_API_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# Required: webhook handler verifies HMAC SHA-256 of incoming Meta payloads.
WHATSAPP_APP_SECRET=CHANGE_ME_FROM_META_APP_DASHBOARD
# Required for the one-time Meta webhook subscription handshake. Pick
# any high-entropy string and paste the same value into Meta's
# webhook config (?hub.verify_token=…).
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_TO_HIGH_ENTROPY_STRING
# AI provider switch. Defaults to deepseek; flip to openai or
# anthropic and set the matching key below to A/B-test or migrate.
AI_PROVIDER=deepseek
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Object storage (R2 / S3-compatible) for campaign attachments, promo
# cards and uploaded avatars. Cloudflare R2 has zero egress; any S3
# endpoint works.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Required: Resend API key for transactional emails (reset-password, verify-email).
RESEND_API_KEY=CHANGE_ME_FROM_RESEND_DASHBOARD
# Required: AES-256-GCM master key used to wrap per-account TOTP secrets at
# rest. Generate with `openssl rand -base64 32` and store in the Secret
# Manager (ACH-016). Rotating this invalidates all existing TOTP enrolments.
TOTP_ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_32

# ── Observability ─────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── OAuth (Google Login) ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Domain (used by certbot) ─────────────────────────────────
DOMAIN=app.seudominio.com.br

# ── Grafana ───────────────────────────────────────────────────
# Required: docker-compose refuses to boot Grafana if missing.
GRAFANA_PASSWORD=REPLACE_WITH_OPENSSL_RAND_BASE64_24
