# WBC Platform — Production Environment Variables
# Copy to .env.production and fill in real values

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=wbc
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=wbc

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Auth ──────────────────────────────────────────────────────
# AUTH_SECRET must be ≥32 chars and free of weak/placeholder patterns
# (change/secret/wbc-dev/placeholder/generate). Generate with:
#   openssl rand -base64 48
AUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_48
AUTH_URL=https://app.seudominio.com.br

# ── External APIs ────────────────────────────────────────────
DEEPSEEK_API_KEY=your-deepseek-key
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-token
WHATSAPP_API_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# Required: webhook handler verifies HMAC SHA-256 of incoming Meta payloads.
WHATSAPP_APP_SECRET=CHANGE_ME_FROM_META_APP_DASHBOARD
# Required: Resend API key for transactional emails (reset-password, verify-email).
RESEND_API_KEY=CHANGE_ME_FROM_RESEND_DASHBOARD
# Required: AES-256-GCM master key used to wrap per-account TOTP secrets at
# rest. Generate with `openssl rand -base64 32` and store in the Secret
# Manager (ACH-016). Rotating this invalidates all existing TOTP enrolments.
TOTP_ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_32

# ── Observability ─────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── OAuth (Google Login) ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Domain (used by certbot) ─────────────────────────────────
DOMAIN=app.seudominio.com.br
