# ── Stage 1: Base ──────────────────────────────────────────────
# ACH-004/ACH-014 supply-chain-dependencias: pin Node minor por digest.
# Tag node:20.18.1-alpine em 2026-04-23. Atualizar com Dependabot docker-ecosystem.
FROM node:20.18.1-alpine@sha256:24fb6aa7020d9a20b00d6da6d1714187c45ed00d1eb4adb01395843c338b9372 AS base
RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app

# ── Stage 2: Prune monorepo ───────────────────────────────────
FROM base AS pruner
RUN pnpm add -g turbo@2
COPY . .
RUN turbo prune @wbc/web --docker

# ── Stage 3: Install + Build ──────────────────────────────────
FROM base AS builder
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile

COPY --from=pruner /app/out/full/ .
COPY packages/business/ ./packages/business/

# ACH-015: DATABASE_URL delivered via BuildKit secret (never cached in layer).
# Producers: `docker build --secret id=database_url,src=/path/to/file` or CI
# workflow (see .github/workflows/docker-images.yml).
# Fallback: if the secret is not mounted, `prisma generate` runs with the
# default DATABASE_URL baked into the .env* files of the repo (for local dev).
RUN --mount=type=secret,id=database_url \
    if [ -f /run/secrets/database_url ]; then \
      export DATABASE_URL="$(cat /run/secrets/database_url)"; \
    fi && \
    pnpm --filter @wbc/db db:generate && \
    pnpm --filter @wbc/web build

# ── Stage 4: Production runner ────────────────────────────────
# ACH-004/ACH-014 supply-chain-dependencias: pin por digest (mesma imagem de base).
FROM node:20.18.1-alpine@sha256:24fb6aa7020d9a20b00d6da6d1714187c45ed00d1eb4adb01395843c338b9372 AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static

USER nextjs
EXPOSE 3000

ENV HOSTNAME="0.0.0.0"
ENV PORT=3000

CMD ["node", "apps/web/server.js"]
