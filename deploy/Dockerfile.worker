# ── Stage 1: Base ──────────────────────────────────────────────
# ACH-004/ACH-014 supply-chain-dependencias: pin Node minor por digest.
# Tag node:20.18.1-alpine em 2026-04-23. Atualizar com Dependabot docker-ecosystem.
FROM node:25.9.0-alpine@sha256:bdf2cca6fe3dabd014ea60163eca3f0f7015fbd5c7ee1b0e9ccb4ced6eb02ef4 AS base
RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app

# ── Stage 2: Install deps ─────────────────────────────────────
FROM base AS builder
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/config/package.json ./packages/config/
COPY packages/shared/package.json ./packages/shared/
COPY packages/db/package.json ./packages/db/
COPY apps/worker/package.json ./apps/worker/

RUN pnpm install --frozen-lockfile

COPY packages/ ./packages/
COPY apps/worker/ ./apps/worker/

# ACH-015: DATABASE_URL via BuildKit secret (never cached in layer).
RUN --mount=type=secret,id=database_url \
    if [ -f /run/secrets/database_url ]; then \
      export DATABASE_URL="$(cat /run/secrets/database_url)"; \
    fi && \
    pnpm --filter @wbc/db db:generate

# Worker uses tsx at runtime (TypeScript execution)
# No build step needed — tsx runs .ts directly

# ── Stage 3: Production runner ────────────────────────────────
# ACH-004/ACH-014 supply-chain-dependencias: pin por digest (mesma imagem de base).
FROM node:25.9.0-alpine@sha256:bdf2cca6fe3dabd014ea60163eca3f0f7015fbd5c7ee1b0e9ccb4ced6eb02ef4 AS runner
RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 worker
RUN adduser --system --uid 1001 worker

COPY --from=builder --chown=worker:worker /app ./

USER worker

CMD ["npx", "tsx", "apps/worker/src/index.ts"]
