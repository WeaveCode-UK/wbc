{
  "title": "WBC Overview",
  "uid": "wbc-overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "tRPC Request Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (type) (rate(wbc_trpc_requests_total[1m]))",
          "legendFormat": "{{type}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "tRPC p95 Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, type) (rate(wbc_trpc_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{type}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "Outbox Lag (ms)",
      "type": "timeseries",
      "targets": [{ "expr": "wbc_outbox_lag_ms" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "title": "BullMQ Queue Depth",
      "type": "timeseries",
      "targets": [
        {
          "expr": "wbc_bullmq_queue_depth",
          "legendFormat": "{{queue}} — {{state}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },
    {
      "id": 5,
      "title": "Domain Errors",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (error_class) (rate(wbc_domain_errors_total[5m]))",
          "legendFormat": "{{error_class}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }
    },
    {
      "id": 6,
      "title": "DLQ Events",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (queue) (rate(wbc_dlq_events_total[5m]))",
          "legendFormat": "{{queue}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }
    }
  ]
}
