// ============================================================
// LOGISTICS
// ============================================================

model Delivery {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId        String         @unique @db.Uuid
  clientId      String         @db.Uuid
  method        DeliveryMethod
  trackingCode  String?
  status        DeliveryStatus @default(CONFIRMED)
  estimatedDays Int?
  address       String?
  shippedAt     DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime       @default(now())

  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id])

  // ACH-005 dados-persistencia: Delivery rows aren't tenant-scoped via
  // column — they inherit tenant through the Sale. Status filter is
  // the dashboard query; index on client is for personal delivery
  // listings.
  @@index([status])
  @@index([clientId])
  @@map("deliveries")
}

enum DeliveryMethod {
  PERSONAL
  MAIL
  COURIER
  PICKUP
}

enum DeliveryStatus {
  CONFIRMED
  SEPARATED
  SHIPPED
  DELIVERED
}

