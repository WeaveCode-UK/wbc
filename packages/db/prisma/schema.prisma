  scheduledAt DateTime?
  createdAt   DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // ACH-005 dados-persistencia: team task list + per-member filter.
  @@index([teamId, memberId])
  @@map("team_tasks")
}

