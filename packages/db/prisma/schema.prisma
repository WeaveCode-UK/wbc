// ============================================================
// WBC — Wave Beauty Consultant
// Schema Prisma v1.0
// Multi-tenant via tenant_id + RLS
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto]
}

// ============================================================
// TENANT & AUTH
// ============================================================

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   // nome do negócio (ex: "Renata Cosméticos")
  slug      String   @unique // usado no subdomínio da landing page
  timezone  String   @default("America/Sao_Paulo")
  currency  String   @default("BRL")
  locale    String   @default("pt-BR")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription      Subscription?
  members           TenantMember[]
  invites           Invite[]
  clients           Client[]
  tags              Tag[]
  products          Product[]
  showcases         Showcase[]
  sales             Sale[]
  cashbacks         Cashback[]
  stocks            Stock[]
  brandOrders       BrandOrder[]
  samples           Sample[]
  campaigns         Campaign[]
  scheduledMessages ScheduledMessage[]
  messageTemplates  MessageTemplate[]
  quickReplies      QuickReply[]
  expenses          Expense[]
  financialReports  FinancialReport[]
  appointments      Appointment[]
  reminders         Reminder[]
  opportunities     Opportunity[]
  team              Team?
  aiGenerations     AIGeneration[]
  landingPage       LandingPage?
  referralsMade     Referral[]        @relation("referrer")
  referralsReceived Referral[]        @relation("referred")
  onboarding        OnboardingProgress?

  @@map("tenants")
}

enum Role {
  CONSULTANT
  LEADER
  DIRECTOR
  ADMIN
}

enum Plan {
  ESSENTIAL
  PRO
}

model Subscription {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String   @unique @db.Uuid
  plan                Plan
  status              SubStatus @default(ACTIVE)
  startsAt            DateTime
  expiresAt           DateTime?
  aiGenerationsUsed   Int      @default(0)
  aiGenerationsLimit  Int      @default(30)
  // ACH-003 dados-persistencia: optimistic-locking version. Writers
  // that care about lost-update semantics call `optimisticUpdate`
  // which bumps this field and conditions the WHERE on it, so two
  // concurrent increments can't both succeed.
  version             Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum SubStatus {
  ACTIVE
  TRIAL
  EXPIRED
  CANCELLED
}

model OtpCode {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String     @db.Uuid
  code      String
  purpose   OtpPurpose @default(TWO_FACTOR)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, code])
  @@index([accountId])
  @@map("otp_codes")
}

// ============================================================
// CLIENTS
// ============================================================

model Client {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String          @db.Uuid
  name             String
  phone            String
  email            String?
  sex              Sex?
  birthday         DateTime?       @db.Date
  profession       String?
  skinType         SkinType?
  hairType         HairType?
  allergies        String?         // texto livre
  makeupTones      String?         // texto livre
  preferences      String?         // texto livre
  notes            String?         // notas livres da consultora
  source           ClientSource    @default(MANUAL)
  classification   Classification  @default(C)
  engagementScore  Int             @default(0)
  firstPurchaseAt  DateTime?
  isLead           Boolean         @default(false)
  isActive         Boolean         @default(true)
  version          Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tags             ClientTag[]
  wishlist         ClientWishlist[]
  giftSuggestors   GiftSuggestor[]
  sales            Sale[]
  cashbacks        Cashback[]
  scheduledMessages ScheduledMessage[]
  reminders        Reminder[]
  opportunities    Opportunity[]
  appointments     Appointment[]
  campaignRecipients CampaignRecipient[]
  samples          Sample[]
  deliveries       Delivery[]

  @@unique([tenantId, phone])
  @@index([tenantId, classification])
  @@index([tenantId, isLead])
  @@map("clients")
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum SkinType {
  OILY
  DRY
  COMBINATION
  NORMAL
  SENSITIVE
}

enum HairType {
  STRAIGHT
  WAVY
  CURLY
  COILY
}

enum ClientSource {
  MANUAL
  QRCODE
  IMPORT
  AUTOCADASTRO
  WHATSAPP
  SPREADSHEET
  REFERRAL
}

enum Classification {
  A  // top compradoras
  B  // regulares
  C  // esporádicas
}

model Tag {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String     @db.Uuid
  name      String
  autoRule  String?    // regra JSON para etiqueta automática (nullable = manual)
  color     String?
  createdAt DateTime   @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clients   ClientTag[]

  @@unique([tenantId, name])
  @@map("tags")
}

model ClientTag {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId String @db.Uuid
  tagId    String @db.Uuid

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([clientId, tagId])
  @@map("client_tags")
}

model ClientWishlist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  clientId  String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now())

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([clientId, productId])
  @@map("client_wishlists")
}

model GiftSuggestor {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String @db.Uuid
  clientId       String @db.Uuid
  suggestorName  String
  suggestorPhone String

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // ACH-005 dados-persistencia.
  @@index([tenantId, clientId])
  @@map("gift_suggestors")
}

// ============================================================
// CATALOG
// ============================================================

model Brand {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  logo     String?
  isSystem Boolean   @default(false) // marcas padrão do sistema

  products Product[]
  brandOrders BrandOrder[]

  // ACH-007 dados-persistencia: name is global (Brand is not tenant-
  // scoped); unique prevents duplicate catalog entries.
  @@unique([name])
  @@map("brands")
}

model Product {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid
  brandId     String   @db.Uuid
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  costPrice   Decimal? @db.Decimal(10, 2)
  photoUrl    String?
  category    String?
  isCustom    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand     Brand           @relation(fields: [brandId], references: [id])
  saleItems SaleItem[]
  stock     Stock?
  wishlists ClientWishlist[]
  showcaseProducts ShowcaseProduct[]
  samples   Sample[]

  @@index([tenantId, brandId])
  @@index([tenantId, category])
  @@map("products")
}

model Showcase {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  clientId  String?  @db.Uuid  // null = vitrine geral
  name      String
  shareLink String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products ShowcaseProduct[]

  @@map("showcases")
}

model ShowcaseProduct {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  showcaseId String @db.Uuid
  productId  String @db.Uuid
  sortOrder  Int    @default(0)

  showcase Showcase @relation(fields: [showcaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([showcaseId, productId])
  @@map("showcase_products")
}

// ============================================================
// SALES
// ============================================================

model Sale {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String     @db.Uuid
  clientId          String     @db.Uuid
  status            SaleStatus @default(DRAFT)
  deliveryDate      DateTime?  @db.Date
  paymentMethod     PayMethod?
  discount          Decimal    @default(0) @db.Decimal(10, 2)
  total             Decimal    @db.Decimal(10, 2)
  cashbackUsed      Decimal    @default(0) @db.Decimal(10, 2)
  cashbackGenerated Decimal    @default(0) @db.Decimal(10, 2)
  campaignId        String?    @db.Uuid  // origem da venda (campanha)
  notes             String?
  version           Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client    Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  campaign  Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  items     SaleItem[]
  payments  Payment[]
  returns   Return[]
  postSaleFlows PostSaleFlow[]
  delivery  Delivery?

  @@index([tenantId, status])
  @@index([tenantId, clientId])
  @@index([tenantId, createdAt])
  // ACH-013 dados-persistencia: composite for dashboard status-filtered
  // time ranges (most common analytics query).
  @@index([tenantId, status, createdAt])
  @@map("sales")
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  SEPARATED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PayMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
  INSTALLMENT
  BANK_TRANSFER
  OTHER
}

model SaleItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId    String  @db.Uuid
  productId String  @db.Uuid
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // ACH-005 dados-persistencia: FK lookup from Sale → items hits this
  // path on every detail fetch. Without the index it degrades to scan
  // as the table grows.
  @@index([saleId])
  @@map("sale_items")
}

model Payment {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId            String      @db.Uuid
  installmentNumber Int         @default(1)
  amount            Decimal     @db.Decimal(10, 2)
  dueDate           DateTime    @db.Date
  status            PayStatus   @default(PENDING)
  paidAt            DateTime?
  mercadopagoId     String?     // ID do pagamento Mercado Pago
  pixQrCode         String?     // QR Code gerado
  pixLink           String?     // Link de pagamento
  createdAt         DateTime    @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId, status])
  @@map("payments")
}

enum PayStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model Cashback {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @db.Uuid
  clientId     String   @db.Uuid
  amount       Decimal  @db.Decimal(10, 2)
  usedAmount   Decimal  @default(0) @db.Decimal(10, 2)
  expiresAt    DateTime
  originSaleId String   @db.Uuid
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([tenantId, clientId])
  @@index([expiresAt])
  @@map("cashbacks")
}

// ACH-012 dados-persistencia: idempotent cashback redemption.
// Writes happen inside the same Serializable transaction as the
// `Cashback.usedAmount` updates. A retry presents the same
// `idempotencyKey` and either (a) hits the PK and the redemption
// returns no-op, or (b) was already committed and the Serializable
// isolation prevents a concurrent second application.
//
// `tenantId` is part of the key so two tenants can't collide on the
// same client-generated id.
model CashbackRedemption {
  tenantId       String   @db.Uuid
  idempotencyKey String
  clientId       String   @db.Uuid
  amount         Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  @@id([tenantId, idempotencyKey])
  @@index([tenantId, clientId])
  @@map("cashback_redemptions")
}

model Return {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId       String   @db.Uuid
  reason       String
  refundAmount Decimal  @db.Decimal(10, 2)
  stockUpdated Boolean  @default(false)
  createdAt    DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  // ACH-005 dados-persistencia.
  @@index([saleId])
  @@map("returns")
}

// ============================================================
// INVENTORY
// ============================================================

model Stock {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @db.Uuid
  productId String @unique @db.Uuid
  quantity  Int    @default(0)
  minAlert  Int    @default(0)
  version   Int    @default(0)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId])
  @@map("stocks")
}

model BrandOrder {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String          @db.Uuid
  brandId    String          @db.Uuid
  status     OrderStatus     @default(ORDERED)
  notes      String?
  orderedAt  DateTime        @default(now())
  receivedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand  Brand  @relation(fields: [brandId], references: [id])
  items  BrandOrderItem[]

  // ACH-005 dados-persistencia: list by status is the dashboard query.
  @@index([tenantId, status])
  @@map("brand_orders")
}

enum OrderStatus {
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

model BrandOrderItem {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brandOrderId String @db.Uuid
  productName  String
  quantity     Int
  unitCost     Decimal @db.Decimal(10, 2)

  brandOrder BrandOrder @relation(fields: [brandOrderId], references: [id], onDelete: Cascade)

  // ACH-005 dados-persistencia: FK lookup for order details.
  @@index([brandOrderId])
  @@map("brand_order_items")
}

model Sample {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid
  productId      String   @db.Uuid
  clientId       String?  @db.Uuid
  quantity       Int      @default(1)
  cost           Decimal  @db.Decimal(10, 2)
  resultedInSale Boolean  @default(false)
  createdAt      DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  client  Client? @relation(fields: [clientId], references: [id])

  // ACH-005 dados-persistencia.
  @@index([tenantId, clientId])
  @@map("samples")
}

// ============================================================
// CAMPAIGNS & MESSAGING
// ============================================================

model Campaign {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String         @db.Uuid
  name         String
  message      String
  audioUrl     String?
  attachments  Json?          // array de URLs
  status       CampaignStatus @default(DRAFT)
  scheduledAt  DateTime?
  statsReceived Int           @default(0)
  statsViewed   Int           @default(0)
  statsReplied  Int           @default(0)
  statsSales    Int           @default(0)
  shareOnFeed   Boolean       @default(false)
  // ACH-003 dados-persistencia: optimistic-locking version for the
  // concurrent stats increments (viewed/replied/sales come from async
  // handlers and can race).
  version       Int           @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipients CampaignRecipient[]
  sales      Sale[]

  @@index([tenantId, status])
  @@map("campaigns")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  CANCELLED
}

model CampaignRecipient {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId String          @db.Uuid
  clientId   String          @db.Uuid
  status     RecipientStatus @default(PENDING)
  sentAt     DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@unique([campaignId, clientId])
  @@map("campaign_recipients")
}

enum RecipientStatus {
  PENDING
  SENT
  RECEIVED
  VIEWED
  REPLIED
  FAILED
}

model ScheduledMessage {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String        @db.Uuid
  clientId  String        @db.Uuid
  message   String
  audioUrl  String?
  sendAt    DateTime
  status    MessageStatus @default(PENDING)
  type      MessageType
  createdAt DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id])

  @@index([tenantId, sendAt, status])
  @@map("scheduled_messages")
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum MessageType {
  INDIVIDUAL
  POST_SALE
  RESTOCK_REMINDER
  BILLING_REMINDER
  BIRTHDAY
  PROFESSION_DAY
  WELCOME
  REACTIVATION
  CASHBACK_EXPIRING
  GIFT_SUGGESTOR
  CUSTOM
}

model PostSaleFlow {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId         String        @db.Uuid
  clientId       String        @db.Uuid
  stage          PostSaleStage
  messageVariant Int           @default(1) // qual variação do template (1-5)
  scheduledAt    DateTime
  sentAt         DateTime?
  status         MessageStatus @default(PENDING)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([scheduledAt, status])
  // ACH-005 dados-persistencia: FK lookup by sale.
  @@index([saleId])
  @@map("post_sale_flows")
}

enum PostSaleStage {
  TWO_DAYS
  TWO_WEEKS
  TWO_MONTHS
  RESTOCK
}

model MessageTemplate {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String?          @db.Uuid  // null = template do sistema
  name      String
  category  TemplateCategory
  text      String
  variant   Int              @default(1) // variações 1-5
  isSystem  Boolean          @default(false)
  locale    String           @default("pt-BR")
  createdAt DateTime         @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, category])
  @@map("message_templates")
}

enum TemplateCategory {
  RESTOCK
  BIRTHDAY
  PROFESSION_DAY
  PROMOTION
  POST_SALE_2D
  POST_SALE_2W
  POST_SALE_2M
  BILLING
  WELCOME
  REACTIVATION
  CASHBACK_EXPIRING
  GIFT_SUGGESTOR
  CUSTOM
}

model CommunityTemplate {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @db.Uuid
  text       String
  topic      String?
  likesCount Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([likesCount(sort: Desc)])
  @@index([topic])
  // ACH-005 dados-persistencia: tenant-scoped queries need this.
  @@index([tenantId])
  @@map("community_templates")
}

model QuickReply {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  label    String
  text     String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // ACH-005 dados-persistencia.
  @@index([tenantId])
  @@map("quick_replies")
}

// ============================================================
// FINANCE
// ============================================================

model Expense {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  description String
  amount    Decimal  @db.Decimal(10, 2)
  category  String?
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@map("expenses")
}

model FinancialReport {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @db.Uuid
  period        String   // ex: "2026-03"
  totalRevenue  Decimal  @db.Decimal(10, 2)
  totalExpenses Decimal  @db.Decimal(10, 2)
  netProfit     Decimal  @db.Decimal(10, 2)
  generatedAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, period])
  @@map("financial_reports")
}

// ============================================================
// SCHEDULE
// ============================================================

model Appointment {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String          @db.Uuid
  clientId  String?         @db.Uuid
  title     String
  type      AppointmentType
  address   String?
  notes     String?
  startsAt  DateTime
  endsAt    DateTime?
  createdAt DateTime        @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id])

  @@index([tenantId, startsAt])
  @@map("appointments")
}

enum AppointmentType {
  VISIT
  DEMO
  BEAUTY_DAY
  DELIVERY
  OTHER
}

model Reminder {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String         @db.Uuid
  clientId    String         @db.Uuid
  type        ReminderType
  message     String?
  triggerDate DateTime       @db.Date
  status      ReminderStatus @default(PENDING)
  createdAt   DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id])

  @@index([tenantId, triggerDate, status])
  @@map("reminders")
}

enum ReminderType {
  RESTOCK
  BIRTHDAY
  PROFESSION_DAY
  CLIENT_ANNIVERSARY
  CUSTOM
}

enum ReminderStatus {
  PENDING
  SENT
  DISMISSED
}

model Opportunity {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid
  clientId    String?  @db.Uuid
  type        String
  description String
  scheduledAt DateTime
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id])

  @@index([tenantId, scheduledAt])
  @@map("opportunities")
}

