// PLATFORM
// ============================================================

model Referral {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrerTenantId String   @db.Uuid
  referredTenantId String?  @db.Uuid
  referralCode     String   @unique
  reward           String?
  usedAt           DateTime?
  createdAt        DateTime @default(now())

  referrer Tenant  @relation("referrer", fields: [referrerTenantId], references: [id], onDelete: Restrict)
  referred Tenant? @relation("referred", fields: [referredTenantId], references: [id], onDelete: SetNull)

  @@map("referrals")
}

model OnboardingProgress {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String @unique @db.Uuid
  stepsCompleted Json   @default("[]") // array de step IDs
  currentStep    String @default("welcome")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("onboarding_progress")
}

// ============================================================
// OUTBOX (Event Bus)
// ============================================================

model OutboxEvent {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        String
  tenantId    String       @db.Uuid
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  nextRetryAt DateTime?
  createdAt   DateTime     @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
  @@index([status, nextRetryAt])
  @@map("outbox_events")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DLQ
}

// ACH-011 dados-persistencia: handler-side idempotency. Each outbox
// consumer writes `(eventId, handlerName)` into this table inside the
// same transaction as its side-effect. A retry after crash or at-least-
// once redelivery hits the unique constraint and the handler returns
// no-op. Without this, a retried SALE_CONFIRMED could decrement stock
// twice, send two WhatsApp messages, etc.
model ProcessedEvent {
  eventId     String   @db.Uuid
  handlerName String
  processedAt DateTime @default(now())

  @@id([eventId, handlerName])
  @@index([processedAt])
  @@map("processed_events")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  title     String
  body      String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tenantId, read])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

// ============================================================
// AUTH 2.0 — Account / TenantMember / Session / Invite
// ============================================================

model Account {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // ACH-007: TOTP MFA. `totpSecret` is stored encrypted (AES-GCM); the
  // application layer wraps/unwraps via `TotpSecretCrypto` so the DB dump
  // alone is not enough to regenerate codes.
  totpSecret         String? // encrypted base32 secret ("iv:ciphertext:tag" hex)
  totpEnabled        Boolean  @default(false)
  totpActivatedAt    DateTime?
  totpRecoveryCodes  String[] @default([]) // one-shot hashes (sha256 hex)

  oauthAccounts OAuthAccount[]
  tenantMembers TenantMember[]
  sessions      Session[]
  otpCodes      OtpCode[]

  @@map("accounts")
}

// ACH-024: AuditLog persiste eventos de segurança e administração para
// forense pós-incidente e cumprimento de requisitos de auditoria LGPD.
// Aplicação grava aqui via AuditLogPort; export periódico fica para Fase 7.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String?  @db.Uuid
  accountId  String?  @db.Uuid
  action     String
  resource   String
  resourceId String?
  status     String   // 'success' | 'failure' | 'denied'
  ip         String?
  userAgent  String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([accountId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model OAuthAccount {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId         String   @db.Uuid
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?
  createdAt         DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([accountId])
  @@map("oauth_accounts")
}

model TenantMember {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId   String    @db.Uuid
  tenantId    String    @db.Uuid
  role        Role      @default(CONSULTANT)
  phone       String?
  displayName String?
  avatar      String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  joinedAt    DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([accountId, tenantId])
  @@index([tenantId])
  @@index([accountId])
  @@map("tenant_members")
}

model Session {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String   @db.Uuid
  tenantId   String?  @db.Uuid
  tokenHash  String   @unique
  expiresAt  DateTime
  userAgent  String?
  ipAddress  String?
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@map("sessions")
}

model Invite {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String       @db.Uuid
  email      String
  role       Role         @default(CONSULTANT)
  invitedBy  String       @db.Uuid
  token      String       @unique
  status     InviteStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([tenantId])
  @@map("invites")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum OtpPurpose {
  TWO_FACTOR
  EMAIL_VERIFICATION
}
